#!/usr/bin/env bash
#
# nick-agent: opens the claude of one agent of the nick shell (NS-33, NS-35) in the project of the
# cwd, with the prompt of an auto_scrum stage, by the same path as auto_scrum.sh: the project
# config (.nick/nick.conf of the cwd, through lib/config/), jail_check, claude_settings_load,
# claude_permission_notice, jail_agent_notice and jail_exec of lib/, and the prompt assembly of
# auto_scrum/prompt.sh. The nick shell runs it as `bash <absolute path of this script> ...` with
# the cwd at the project: --check and --render outside the PTY, then the launch in it.
#   nick-agent --check
#       only validates (the config and the jail), launching nothing and writing nothing. On
#       success prints exactly three lines on stdout, jail=, jira= and sentry=, each true or
#       false (true only with "true" exactly in the config: the rule of jail_exec and of
#       choose_type), and exits with 0; the warnings of config_load go to stderr and don't change
#       the result. On failure, the message of the lib on stderr and exit 1.
#   nick-agent --render <type> [--title <v>] [--description <v>] [--jira-id <v>]
#              [--jira-link <v>] [--sentry-link <v>] [--plan-path <v>]
#       the same checks, then the answers of <type> (one of the 8 types of choose_type, available
#       by the same flags) with the rules of its ask_questions_<type> (required, optional,
#       jira_id_valid), the default plan path, and the prompt
#       built by prompt.sh into auto_scrum/logs/<type>_<date>.md (the log of auto_scrum.sh). Prints
#       log=<absolute path of the log> and then the jail status (jail_print_status). Writes
#       nothing in the project and launches nothing. The answers come trimmed as read does: the
#       nick shell trims them (stages::trim_read); here an answer that read takes, made only of
#       spaces, tabs and line breaks, counts as empty (read would leave it empty), and the long
#       description (read_via_editor, which takes the text as it is) only has to be non-empty.
#   nick-agent --session-id <uuid> --name <name> --type <type> --prompt-file <file>
#       the same checks, then config_dir_prepare (as auto_scrum does before launching),
#       jail_print_status and jail_exec of claude with the argv of auto_scrum.sh plus --session-id
#       and --name: the deny/ask rules, --permission-mode auto only with --type development, one
#       --append-system-prompt, always (NS-41), with the instruction not to work around a refused
#       command (claude_permission_notice) and, only with the jail on, a blank line and the jail
#       notice, --session-id, --name and the content of <file> (the log of --render) as the last
#       argument.
#   nick-agent --resume <uuid> --name <name> --stage <stage> [--opened-id <id>]
#              (--ticket-id <id> | --epic-id <id>)
#       (NS-39) resumes the conversation <uuid> of a stopped agent, by the same path as the launch
#       (the same checks, config_dir_prepare, jail_print_status and jail_exec, with the config of
#       now): claude --settings <rules> [--permission-mode auto only with --stage development]
#       --append-system-prompt <notice> --resume <uuid> --name <name>, with no prompt. The
#       notice always starts with claude_permission_notice (NS-41); then, each after a blank
#       line, the jail one (only with the jail on) and, when --opened-id (the ticket key the
#       agent was opened with) differs from --ticket-id (the key of now), resume_id_notice
#       (auto_scrum/prompt.sh): the folder of the ticket changed. The stage, and
#       not the type, because the type of an agent is not stored. An agent of an epic (NS-40) gets
#       --epic-id in the place of --ticket-id (exactly one of the two), and the notice of an epic.
#   nick-agent --has-conversation <uuid>
#       (NS-39) prints exactly conversation=true or conversation=false and exits with 0: whether
#       claude keeps the conversation <uuid> of a session run with the cwd at this project
#       (claude_conversation_file of lib/claude/, under ${CLAUDE_CONFIG_DIR:-$HOME/.claude}). It
#       needs no config, launches nothing and writes nothing.
# The UUID format is not checked here (claude checks it; the nick always generates a valid one).
# There is no variable that swaps this script nor any part of the launch: the shell finds it by a
# path fixed at build time, and this is the path that guarantees the jail and the rules.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The command that creates the project config in the cwd, absolute so the user can paste it from
# the error message (the same message as auto_scrum's resolve_stack).
AGENT_INIT_BIN="$SCRIPT_DIR/nick-init"
# shellcheck source=SCRIPTDIR/../lib/config/config.sh
source "$SCRIPT_DIR/../lib/config/config.sh"
# shellcheck source=SCRIPTDIR/../lib/config/keys.sh
source "$SCRIPT_DIR/../lib/config/keys.sh"
# shellcheck source=SCRIPTDIR/../lib/jail/jail.sh
source "$SCRIPT_DIR/../lib/jail/jail.sh"
# shellcheck source=SCRIPTDIR/../lib/claude/claude.sh
source "$SCRIPT_DIR/../lib/claude/claude.sh"
# The prompt assembly of the auto_scrum stages, the same auto_scrum.sh loads (NS-35): the
# answers, the blocks, render_prompt, jira_id_valid and warn_legacy_plan.
# shellcheck source=SCRIPTDIR/../auto_scrum/prompt.sh
source "$SCRIPT_DIR/../auto_scrum/prompt.sh"

# The keys of the config (lib/config/keys.sh). A bad registration stops the script on load
# (set -e): it is a programming error.
config_register_nick_keys

# The keys this script reads, written by config_load (empty when the file lacks them; an
# inherited environment variable of the same name never counts). The prompt blocks read
# STACK_DESCRIPTION and the *_ENABLED flags.
STACK_DESCRIPTION=""
JIRA_ENABLED=""
SENTRY_ENABLED=""
PERMISSION_ENABLED=""
PRODUCTION_ENABLED=""
TDD_ENABLED=""
JAIL_ENABLED=""
JAIL_CLIPBOARD=""
JAIL_FORWARD_PORTS=""
JAIL_ALLOW_HOSTS=""
# The content of lib/claude/permissions.json (claude_settings_load). Never CLAUDE_*: Claude Code
# reads CLAUDE_* from the environment.
NICK_CLAUDE_SETTINGS=""
# The extra hosts of the jail: the MCPs (jail_mcp_hosts) and then JAIL_ALLOW_HOSTS, the same
# string auto_scrum.sh builds.
AGENT_JAIL_HOSTS=""
# The types of the stages: the $TYPE values of choose_type (auto_scrum.sh), in its order
# (bin/tests/test_nick_agent.sh compares both).
AGENT_TYPES=(po po_discussion po_jira po_sentry tech_leader tech_leader_jira development review)
# The stages of an agent (the agents.stage column of the nick shell, NS-39: --resume).
AGENT_STAGES=(po tech_leader development review)

# usage_error <message>: the error and the usage on stderr, exit 1 (the pattern of bin/nick-init).
usage_error() {
  echo "Erro: $1" >&2
  echo "Uso: nick-agent --check | --render <tipo> [respostas] | --session-id <uuid> --name <nome> --type <tipo> --prompt-file <arquivo> | --resume <uuid> --name <nome> --stage <etapa> [--opened-id <id>] (--ticket-id <id> | --epic-id <id>) | --has-conversation <uuid>" >&2
  exit 1
}

# load_and_check: the checks of every mode, in order — the old .nick.conf, the cwd config (the
# message of auto_scrum's resolve_stack when it is missing), config_load, jail_check (the config
# of the cwd is always the team's shared one) and claude_settings_load. Any failure exits with
# 1, with the message of the lib on stderr.
load_and_check() {
  local cwd_config
  config_cwd_legacy_check || exit 1
  cwd_config="$(config_cwd_file)"
  if [ ! -f "$cwd_config" ]; then
    echo "Erro: não há configuração do projeto em $cwd_config. Rode na raiz do projeto: $AGENT_INIT_BIN" >&2
    exit 1
  fi
  config_load "$cwd_config"
  AGENT_JAIL_HOSTS="$(jail_mcp_hosts "$JIRA_ENABLED" "$SENTRY_ENABLED") $JAIL_ALLOW_HOSTS"
  jail_check "$JAIL_ENABLED" "$JAIL_CLIPBOARD" "$AGENT_JAIL_HOSTS" "$JAIL_FORWARD_PORTS" "$cwd_config" "true" || exit 1
  claude_settings_load NICK_CLAUDE_SETTINGS || exit 1
}

# type_known <type>: whether <type> is one of AGENT_TYPES.
type_known() {
  local known
  for known in "${AGENT_TYPES[@]}"; do
    [ "$known" = "$1" ] && return 0
  done
  return 1
}

# type_available <type>: the rule of choose_type — po_jira and tech_leader_jira only with
# JIRA_ENABLED="true", po_sentry only with SENTRY_ENABLED="true".
type_available() {
  case "$1" in
    po_jira | tech_leader_jira) [ "$JIRA_ENABLED" = "true" ] ;;
    po_sentry) [ "$SENTRY_ENABLED" = "true" ] ;;
    *) return 0 ;;
  esac
}

# type_answers <type>: the answers of <type>, in the order of its ask_questions_<type>, as
# <flag>:<rule> words: required (read_required), optional (read_optional), id (read_jira_id:
# required and jira_id_valid) or text (read_via_editor: required, but taken as it is).
type_answers() {
  case "$1" in
    po) echo "--title:required --description:text" ;;
    po_discussion) echo "--title:required" ;;
    po_jira | tech_leader_jira) echo "--jira-link:required --description:optional" ;;
    po_sentry) echo "--sentry-link:required --description:optional" ;;
    tech_leader) echo "--jira-id:id --title:required --description:text" ;;
    development | review) echo "--jira-id:id --plan-path:optional" ;;
  esac
}

# render_mode <type> [answers...]: the --render mode (see the header).
render_mode() {
  local type="${1:-}" answers flag rule value seen=" " log_file rules blank
  [ "$#" -ge 1 ] || usage_error "informe o tipo depois do --render."
  shift
  type_known "$type" || usage_error "o tipo '$type' não existe."
  answers=" $(type_answers "$type") "
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --title | --description | --jira-id | --jira-link | --sentry-link | --plan-path) ;;
      *) usage_error "argumento desconhecido: '$1'" ;;
    esac
    [ "$#" -ge 2 ] || usage_error "falta o valor de $1."
    case "$answers" in
      *" $1:"*) ;;
      *) usage_error "a resposta $1 não pertence ao tipo '$type'." ;;
    esac
    case "$seen" in
      *" $1 "*) usage_error "a resposta $1 foi repetida." ;;
    esac
    seen="$seen$1 "
    case "$1" in
      --title) TITLE="$2" ;;
      --description) DESCRIPTION="$2" ;;
      --jira-id) JIRA_ID="$2" ;;
      --jira-link) JIRA_LINK="$2" ;;
      --sentry-link) SENTRY_LINK="$2" ;;
      --plan-path) PLAN_PATH="$2" ;;
    esac
    shift 2
  done
  read -r -a rules <<< "$answers"
  for flag in "${rules[@]}"; do
    rule="${flag#*:}"
    flag="${flag%%:*}"
    case "$flag" in
      --title) value="$TITLE" ;;
      --description) value="$DESCRIPTION" ;;
      --jira-id) value="$JIRA_ID" ;;
      --jira-link) value="$JIRA_LINK" ;;
      --sentry-link) value="$SENTRY_LINK" ;;
      --plan-path) value="$PLAN_PATH" ;;
    esac
    # What read leaves of an answer of only spaces, tabs and line breaks: nothing.
    blank="${value//[$' \t\n']/}"
    case "$rule" in
      required | id) [ -n "$blank" ] || usage_error "falta a resposta $flag do tipo '$type'." ;;
      text) [ -n "$value" ] || usage_error "falta a resposta $flag do tipo '$type'." ;;
    esac
    # The message of read_jira_id (auto_scrum.sh), without its "Tente de novo.".
    if [ "$rule" = "id" ] && ! jira_id_valid "$value"; then
      usage_error "ID do Jira inválido: não pode ter /, .., espaço nem caractere de controle (ele vira o nome da pasta $NICK_DOCS_DIR/<ID>/)."
    fi
  done

  load_and_check
  type_available "$type" || usage_error "o tipo '$type' não está disponível neste projeto."
  # The plan and the review paths, with the same lines as ask_questions_development and
  # ask_questions_review (auto_scrum.sh), after the warning of a plan in the old place.
  case "$type" in
    development)
      warn_legacy_plan
      PLAN_PATH="${PLAN_PATH:-$NICK_DOCS_DIR/$JIRA_ID/plan.md}"
      ;;
    review)
      warn_legacy_plan
      PLAN_PATH="${PLAN_PATH:-$NICK_DOCS_DIR/$JIRA_ID/plan.md}"
      REVIEW_PATH="$NICK_DOCS_DIR/$JIRA_ID/review.md"
      ;;
  esac
  build_prompt_blocks
  mkdir -p "$PROMPT_LOGS_DIR"
  log_file="$PROMPT_LOGS_DIR/${type}_$(date +%Y%m%d_%H%M%S).md"
  render_prompt "$PROMPT_TEMPLATES_DIR" "$type" "$log_file"
  echo "log=$log_file"
  jail_print_status "$JAIL_ENABLED" "$JAIL_CLIPBOARD"
}

# launch_mode <args...>: the launch (see the header).
launch_mode() {
  local session_id="" name="" type="" prompt_file=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session-id | --name | --type | --prompt-file)
        [ "$#" -ge 2 ] || usage_error "falta o valor de $1."
        case "$1" in
          --session-id) session_id="$2" ;;
          --name) name="$2" ;;
          --type) type="$2" ;;
          --prompt-file) prompt_file="$2" ;;
        esac
        shift 2
        ;;
      --check | --render) usage_error "o $1 não aceita outros argumentos." ;;
      *) usage_error "argumento desconhecido: '$1'" ;;
    esac
  done
  [ -n "$session_id" ] || usage_error "informe o --session-id <uuid> (não vazio)."
  [ -n "$name" ] || usage_error "informe o --name <nome> (não vazio)."
  [ -n "$type" ] || usage_error "informe o --type <tipo>."
  type_known "$type" || usage_error "o tipo '$type' não existe."
  [ -n "$prompt_file" ] || usage_error "informe o --prompt-file <arquivo>."
  if [ ! -f "$prompt_file" ] || [ ! -r "$prompt_file" ] || [ ! -s "$prompt_file" ]; then
    usage_error "o --prompt-file $prompt_file não é um arquivo legível e não vazio."
  fi

  load_and_check
  config_dir_prepare || exit 1
  jail_print_status "$JAIL_ENABLED" "$JAIL_CLIPBOARD"
  # The argv of auto_scrum.sh plus --session-id and --name (bin/tests/test_nick_agent.sh compares
  # both): the session id and the name the nick chose, and the prompt last, read as the script
  # reads it ($(cat), without the final line breaks).
  exec_claude "$type" "" --session-id "$session_id" --name "$name" "$(cat "$prompt_file")"
}

# exec_claude <type or stage> <notice> [args...]: the end of every launch (the launch and the
# resume, NS-39), after load_and_check: claude by jail_exec with the rules inline, auto mode only
# in the Development stage (ABOUT.md, "Modo auto só na etapa de Desenvolvimento"; the key of the
# type and of the stage is the same, development), one --append-system-prompt, always (NS-41),
# with the instruction not to work around a refused command (claude_permission_notice), then the
# jail notice (only with the jail on) and <notice> (when not empty), each after a blank line, and
# [args]. Never returns (jail_exec ends with exec).
exec_claude() {
  local type="$1" extra_notice="$2" notice claude_args
  shift 2
  claude_args=(--settings "$NICK_CLAUDE_SETTINGS")
  [ "$type" = "development" ] && claude_args+=(--permission-mode auto)
  notice="$(claude_permission_notice)"
  if [ "$JAIL_ENABLED" = "true" ]; then
    notice+=$'\n\n'"$(jail_agent_notice "$AGENT_JAIL_HOSTS" "$JAIL_FORWARD_PORTS")"
  fi
  if [ -n "$extra_notice" ]; then
    notice+=$'\n\n'"$extra_notice"
  fi
  claude_args+=(--append-system-prompt "$notice")
  jail_exec "$JAIL_ENABLED" "$JAIL_CLIPBOARD" "$AGENT_JAIL_HOSTS" "$JAIL_FORWARD_PORTS" claude "${claude_args[@]}" "$@"
}

# stage_known <stage>: whether <stage> is one of AGENT_STAGES.
stage_known() {
  local known
  for known in "${AGENT_STAGES[@]}"; do
    [ "$known" = "$1" ] && return 0
  done
  return 1
}

# resume_mode <args...>: the resume (see the header), its options in any order.
resume_mode() {
  local session_id="" name="" stage="" opened_id="" holder_id="" holder="" seen=" " notice=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --resume | --name | --stage | --opened-id | --ticket-id | --epic-id)
        [ "$#" -ge 2 ] || usage_error "falta o valor de $1."
        case "$seen" in
          *" $1 "*) usage_error "o $1 foi repetido." ;;
        esac
        seen="$seen$1 "
        case "$1" in
          --resume) session_id="$2" ;;
          --name) name="$2" ;;
          --stage) stage="$2" ;;
          --opened-id) opened_id="$2" ;;
          --ticket-id | --epic-id)
            # Exactly one of the two (NS-40): the ticket or the epic of the agent.
            [ -z "$holder" ] || usage_error "informe só um dos dois: --ticket-id ou --epic-id."
            holder="${1#--}"
            holder="${holder%-id}"
            holder_id="$2"
            ;;
        esac
        shift 2
        ;;
      --check | --render | --has-conversation) usage_error "o $1 não aceita outros argumentos." ;;
      *) usage_error "argumento desconhecido: '$1'" ;;
    esac
  done
  [ -n "$session_id" ] || usage_error "informe o --resume <uuid> (não vazio)."
  [ -n "$name" ] || usage_error "informe o --name <nome> (não vazio)."
  [ -n "$stage" ] || usage_error "informe o --stage <etapa>."
  stage_known "$stage" || usage_error "a etapa '$stage' não existe."
  [ -n "$holder" ] || usage_error "informe o --ticket-id <id> ou o --epic-id <id>."
  [ -n "$holder_id" ] || usage_error "informe o --$holder-id <id>."
  # The message of read_jira_id (auto_scrum.sh), without its "Tente de novo."; an --opened-id
  # given goes through it too (empty included).
  jira_id_valid "$holder_id" || usage_error "ID do Jira inválido: não pode ter /, .., espaço nem caractere de controle (ele vira o nome da pasta $NICK_DOCS_DIR/<ID>/)."
  case "$seen" in
    *" --opened-id "*)
      jira_id_valid "$opened_id" || usage_error "ID do Jira inválido: não pode ter /, .., espaço nem caractere de controle (ele vira o nome da pasta $NICK_DOCS_DIR/<ID>/)."
      ;;
  esac

  load_and_check
  config_dir_prepare || exit 1
  jail_print_status "$JAIL_ENABLED" "$JAIL_CLIPBOARD"
  if [ -n "$opened_id" ] && [ "$opened_id" != "$holder_id" ]; then
    notice="$(resume_id_notice "$opened_id" "$holder_id" "$holder")"
  fi
  # No prompt: the conversation goes on where it stopped.
  exec_claude "$stage" "$notice" --resume "$session_id" --name "$name"
}

# has_conversation_mode <uuid>: the --has-conversation mode (see the header). The locale is UTF-8
# here (C.UTF-8, whatever the one of the nick), so an accented letter of the cwd is one "-", as
# claude does (lib/claude/claude.sh: claude_conversation_file).
has_conversation_mode() {
  local LC_ALL=C.UTF-8 file=""
  if [ "$#" -ne 1 ] || [ -z "$1" ]; then
    usage_error "informe o --has-conversation <uuid> (não vazio), sem outros argumentos."
  fi
  claude_conversation_file "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$(pwd -P)" "$1" file
  if [ -f "$file" ]; then echo "conversation=true"; else echo "conversation=false"; fi
}

# launch_kind <args...>: "resume" when --resume is one of the options (the values of the options
# that take one are skipped, so a name "--resume" is a value), "launch" otherwise.
launch_kind() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --resume) echo "resume" && return 0 ;;
      --session-id | --name | --type | --prompt-file | --stage | --opened-id | --ticket-id | --epic-id) shift ;;
    esac
    [ "$#" -gt 0 ] && shift
  done
  echo "launch"
}

main() {
  if [ "$#" -eq 0 ]; then
    usage_error "informe --check, --render <tipo>, --session-id <uuid> --name <nome> --type <tipo> --prompt-file <arquivo>, --resume <uuid> --name <nome> --stage <etapa> --ticket-id <id> (ou --epic-id <id>) ou --has-conversation <uuid>."
  fi
  case "$1" in
    --check)
      [ "$#" -eq 1 ] || usage_error "o --check não aceita outros argumentos."
      load_and_check
      # The effective values: true only with "true" exactly.
      if [ "$JAIL_ENABLED" = "true" ]; then echo "jail=true"; else echo "jail=false"; fi
      if [ "$JIRA_ENABLED" = "true" ]; then echo "jira=true"; else echo "jira=false"; fi
      if [ "$SENTRY_ENABLED" = "true" ]; then echo "sentry=true"; else echo "sentry=false"; fi
      exit 0
      ;;
    --render)
      shift
      render_mode "$@"
      ;;
    --has-conversation)
      shift
      has_conversation_mode "$@"
      ;;
    *)
      if [ "$(launch_kind "$@")" = "resume" ]; then
        resume_mode "$@"
      else
        launch_mode "$@"
      fi
      ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
