#!/usr/bin/env bash
#
# Fake ai-jail of the bin/nick-agent tests (NS-33), used by the bash suite
# (bin/tests/test_nick_agent.sh) and by the Rust tests of the nick shell (nick/src/agent_session.rs
# and nick/tests/agent.rs), in front of the PATH. It never opens a sandbox.
#   --version        prints "ai-jail ${FAKE_JAIL_VERSION:-3.2.0}" and exits with 0;
#   ... -- true      the check of jail_check: appends "ai-jail -- true" to $FAKE_ORDER_LOG (if
#                    set) and exits with 0, writing nothing else;
#   ... -- <command> the launch: writes the whole argv (one argument per line) to
#                    $FAKE_JAIL_LOG, appends "ai-jail" to $FAKE_ORDER_LOG (each only if set) and
#                    execs what comes after the "--".
set -euo pipefail

if [ "${1:-}" = "--version" ]; then
  printf 'ai-jail %s\n' "${FAKE_JAIL_VERSION:-3.2.0}"
  exit 0
fi

all=("$@")
while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
  shift
done
if [ "$#" -eq 0 ]; then
  echo "ai-jail falso: sem -- <comando>" >&2
  exit 2
fi
shift
if [ "$#" -eq 1 ] && [ "$1" = "true" ]; then
  if [ -n "${FAKE_ORDER_LOG:-}" ]; then
    echo "ai-jail -- true" >> "$FAKE_ORDER_LOG"
  fi
  exit 0
fi
if [ -n "${FAKE_JAIL_LOG:-}" ]; then
  printf '%s\n' "${all[@]}" > "$FAKE_JAIL_LOG"
fi
if [ -n "${FAKE_ORDER_LOG:-}" ]; then
  echo "ai-jail" >> "$FAKE_ORDER_LOG"
fi
exec "$@"
