#!/usr/bin/env bash
#
# Fake claude of the bin/nick-agent tests (NS-33), used by the bash suite
# (bin/tests/test_nick_agent.sh) and by the Rust tests of the nick shell (nick/src/agent_session.rs
# and nick/tests/agent.rs), in front of the PATH. It always writes its own argv (one argument per
# line) to $FAKE_CLAUDE_LOG, its environment to $FAKE_CLAUDE_ENV and appends "claude" to
# $FAKE_ORDER_LOG (each only if set). Then, by $FAKE_CLAUDE_MODE:
#   (empty)  prints the marker OK in red (\e[31mOK\e[0m) and exits with 0;
#   echo     puts the terminal in raw mode (as the real claude does), prints READY, reads
#            $FAKE_CLAUDE_READ_BYTES bytes and prints each one in hexadecimal (GOT <hex>);
#   paste    the same, but first turns bracketed paste on (ESC[?2004h) and reads until the end
#            marker of a paste (ESC[201~), then prints every byte read (GOT <hex>);
#   winsize  prints SIZE <rows> <columns> when it starts and on every SIGWINCH, until ended;
#   flood    writes ~1 MB and, at the end, the marker FIM-DO-FLOOD, and exits with 0;
#   sleep    leaves a sleep in the background (same process group, ignoring SIGHUP, to outlive
#            the leader), appends "<pid> <pid of the sleep>" to $FAKE_CLAUDE_PIDS, prints READY
#            and waits until it is ended; with FAKE_CLAUDE_IGNORE_TERM set, it ignores SIGTERM
#            (and so does the sleep), so only a SIGKILL ends them;
#   osc52    asks the terminal to copy "olá" (OSC 52, as claude does to copy), prints COPIADO
#            and exits with 0;
#   exit     prints BYE and exits with $FAKE_CLAUDE_EXIT (default 0);
#   rules    draws, across the whole width of its terminal, a rule (─) and a box row (│caixa
#            ... │), as the real claude does, then prints READY and waits until it is ended
#            (NS-37: the panel of the nick keeps the ends of the program's rows);
#   trigger  prints READY, waits for the file $FAKE_CLAUDE_TRIGGER.1, then rewrites the line of
#            READY with another color (the same text) and creates $FAKE_CLAUDE_TRIGGER.1.done;
#            waits for $FAKE_CLAUDE_TRIGGER.2, prints NOVO (new text) and creates
#            $FAKE_CLAUDE_TRIGGER.2.done; then waits until it is ended;
#   flood_on_trigger  prints READY, waits for the file $FAKE_CLAUDE_TRIGGER.1, then does what
#            flood does;
#   osc52_on_trigger  prints READY; for each n of 1 and 2, waits for the file
#            $FAKE_CLAUDE_TRIGGER.<n>, asks the terminal to copy "olá" (as osc52 does), prints
#            COPIADO <n> and creates $FAKE_CLAUDE_TRIGGER.<n>.done; then waits until it is
#            ended.
# Several agents of one nick share its environment (NS-34): FAKE_CLAUDE_MODE_<name>, when set,
# is the mode of the agent whose cwd is named <name> (the basename of the project, only when it
# is a valid variable name), in place of FAKE_CLAUDE_MODE; and with $FAKE_CLAUDE_LOG_DIR set,
# the argv and the environment also go to <dir>/<name>.argv and <dir>/<name>.env.
set -euo pipefail

project="$(basename "$PWD")"
if [ -n "${FAKE_CLAUDE_LOG:-}" ]; then
  printf '%s\n' "$@" > "$FAKE_CLAUDE_LOG"
fi
if [ -n "${FAKE_CLAUDE_ENV:-}" ]; then
  env > "$FAKE_CLAUDE_ENV"
fi
if [ -n "${FAKE_CLAUDE_LOG_DIR:-}" ]; then
  printf '%s\n' "$@" > "$FAKE_CLAUDE_LOG_DIR/$project.argv"
  env > "$FAKE_CLAUDE_LOG_DIR/$project.env"
fi
if [ -n "${FAKE_ORDER_LOG:-}" ]; then
  echo "claude" >> "$FAKE_ORDER_LOG"
fi
mode="${FAKE_CLAUDE_MODE:-}"
# Only a project whose name is a valid variable name has a mode of its own: with a "-" or a "."
# (meu-proj, proj.v2) the indirect expansion would abort the fake in every mode.
case "$project" in
  "" | [0-9]* | *[!A-Za-z0-9_]*) ;;
  *)
    mode_of_project="FAKE_CLAUDE_MODE_$project"
    if [ -n "${!mode_of_project:-}" ]; then
      mode="${!mode_of_project}"
    fi
    ;;
esac

# Waits until the file $1 exists.
wait_file() {
  while [ ! -e "$1" ]; do
    sleep 0.05
  done
}

flood() {
  head -c 1048576 /dev/zero | tr '\0' 'x'
  printf '\r\nFIM-DO-FLOOD\r\n'
}

case "$mode" in
  echo)
    stty raw -echo
    printf 'READY\r\n'
    got="$(dd bs=1 count="${FAKE_CLAUDE_READ_BYTES:-1}" 2> /dev/null | od -An -tx1 | tr -s ' \n' ' ')"
    printf 'GOT%s\r\n' "$got"
    sleep 0.5
    ;;
  paste)
    stty raw -echo
    printf '\033[?2004hREADY\r\n'
    got=""
    while :; do
      byte="$(dd bs=1 count=1 2> /dev/null | od -An -tx1 | tr -d ' \n')"
      [ -n "$byte" ] || break
      got="$got $byte"
      case "$got" in
        *" 1b 5b 32 30 31 7e") break ;;
      esac
    done
    printf 'GOT%s\r\n' "$got"
    sleep 0.5
    ;;
  winsize)
    # Ends on the Ctrl+C (cooked mode) for sure: without the trap, a SIGINT that arrives as
    # a sleep ends normally is taken by the bash as handled by the child, and the loop goes on
    # (review NS-49, O1: ~1 in 100 in a probe).
    trap 'exit 130' INT
    trap 'echo "SIZE $(stty size)"' WINCH
    echo "SIZE $(stty size)"
    while :; do
      sleep 0.05
    done
    ;;
  flood)
    flood
    ;;
  trigger)
    printf 'READY\r\n'
    wait_file "$FAKE_CLAUDE_TRIGGER.1"
    printf '\033[A\r\033[32mREADY\033[0m\r\n'
    : > "$FAKE_CLAUDE_TRIGGER.1.done"
    wait_file "$FAKE_CLAUDE_TRIGGER.2"
    printf 'NOVO\r\n'
    : > "$FAKE_CLAUDE_TRIGGER.2.done"
    while :; do
      sleep 0.05
    done
    ;;
  osc52_on_trigger)
    printf 'READY\r\n'
    for n in 1 2; do
      wait_file "$FAKE_CLAUDE_TRIGGER.$n"
      printf '\033]52;c;b2zDoQ==\a'
      printf 'COPIADO %s\r\n' "$n"
      : > "$FAKE_CLAUDE_TRIGGER.$n.done"
    done
    while :; do
      sleep 0.05
    done
    ;;
  flood_on_trigger)
    printf 'READY\r\n'
    wait_file "$FAKE_CLAUDE_TRIGGER.1"
    flood
    ;;
  sleep)
    if [ -n "${FAKE_CLAUDE_IGNORE_TERM:-}" ]; then
      trap "" TERM
    fi
    # Ignored before the fork, so the sleep is born ignoring SIGHUP: with the trap inside the
    # child, a SIGHUP to the group right after READY could come first (review NS-34, P4).
    trap "" HUP
    sleep 300 &
    trap - HUP
    printf '%s %s\n' "$$" "$!" >> "$FAKE_CLAUDE_PIDS"
    echo READY
    wait
    ;;
  osc52)
    printf '\033]52;c;b2zDoQ==\a'
    printf 'COPIADO\r\n'
    ;;
  rules)
    cols="$(stty size | cut -d ' ' -f 2)"
    printf '%*s\r\n' "$cols" '' | sed 's/ /─/g'
    printf '│%-*s│\r\n' "$((cols - 2))" 'caixa'
    printf 'READY\r\n'
    while :; do
      sleep 0.05
    done
    ;;
  exit)
    printf 'BYE\r\n'
    exit "${FAKE_CLAUDE_EXIT:-0}"
    ;;
  *)
    printf '\033[31mOK\033[0m\r\n'
    ;;
esac
